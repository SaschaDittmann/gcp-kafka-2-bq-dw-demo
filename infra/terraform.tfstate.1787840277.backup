            "resource_tags": {},
            "schema": "[{\"mode\":\"NULLABLE\",\"name\":\"album_id\",\"type\":\"INTEGER\"},{\"mode\":\"NULLABLE\",\"name\":\"title\",\"type\":\"STRING\"},{\"mode\":\"NULLABLE\",\"name\":\"artist_id\",\"type\":\"INTEGER\"},{\"mode\":\"NULLABLE\",\"name\":\"is_deleted\",\"type\":\"BOOLEAN\"},{\"mode\":\"NULLABLE\",\"name\":\"_loaded_at\",\"type\":\"TIMESTAMP\"},{\"mode\":\"NULLABLE\",\"name\":\"_source_ts_ms\",\"type\":\"INTEGER\"}]",
            "schema_foreign_type_info": [],
            "self_link": "https://bigquery.googleapis.com/bigquery/v2/projects/kafka-2-bq-streaming-demo/datasets/silver/tables/album",
            "table_constraints": [],
            "table_id": "album",
            "table_metadata_view": null,
            "table_replication_info": [],
            "terraform_labels": {
              "env": "demo",
              "goog-terraform-provisioned": "true",
              "managed_by": "terraform",
              "project": "cdc-pipeline-demo"
            },
            "time_partitioning": [],
            "type": "VIEW",
            "view": [
              {
                "query": "SELECT\n  CAST(JSON_VALUE(after, '$.album_id') AS INT64)   AS album_id,\n  JSON_VALUE(after, '$.title')                     AS title,\n  CAST(JSON_VALUE(after, '$.artist_id') AS INT64)  AS artist_id,\n  IF(op = 'd', TRUE, FALSE)                        AS is_deleted,\n  _loaded_at,\n  ts_ms                                            AS _source_ts_ms\nFROM `kafka-2-bq-streaming-demo.bronze.album_raw`\nQUALIFY ROW_NUMBER() OVER (\n  PARTITION BY CAST(JSON_VALUE(after, '$.album_id') AS INT64)\n  ORDER BY _loaded_at DESC, ts_ms DESC\n) = 1\n",
                "use_legacy_sql": false
              }
            ]
          },
